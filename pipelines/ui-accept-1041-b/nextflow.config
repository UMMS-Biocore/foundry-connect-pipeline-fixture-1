
//~@:~
@~:"bin/edit_chromosomes.py"
//~@:~
#!/usr/bin/env python3

import argparse

def main(args):

	if args.prefix != '':
		prefix = '%s%s' % (args.prefix, args.delimiter)
	else:
		prefix = ''

	if args.postfix != '':
		postfix = '%s%s' % (args.delimiter, args.postfix)
	else:
		postfix = ''

	if args.fasta != '' and args.fasta[:7] != 'NO_FILE':
		process_fasta(args.fasta, prefix, postfix)
	
	if args.gtf != '' and args.gtf[:7] != 'NO_FILE':
		process_gtf(args.gtf, prefix, postfix)

def process_fasta(input_file, prefix, postfix):
	
	output = []

	with open(input_file) as infile:
		for line in infile:
			if line[0] == '>':
				output.append('>%s%s%s' % (prefix, line[1:].rstrip(), postfix))
			else:
				output.append(line.rstrip())

	with open('genome.fa', 'w') as out:
		out.write('\n'.join(output)) 

def process_gtf(input_file, prefix, postfix):

	output = []

	with open(input_file) as infile:
		for line in infile:
			if line[0] != '#':
				cur = line.rstrip().split('\t')
				chrom = '%s%s%s' % (prefix, cur[0], postfix)
				output.append('%s\t%s' % (chrom, '\t'.join(cur[1:])))

	with open('annotation.gtf', 'w') as out:
		out.write('\n'.join(output)) 

def parseArguments():
	parser = argparse.ArgumentParser(prog="edit_chromosomes.py", description='', usage='%(prog)s [options]')
	
	input_args = parser.add_argument_group('Input')
	input_args.add_argument('-f', '--fasta', default='', help='Name of fasta file.', metavar='', dest='fasta')
	input_args.add_argument('-g', '--gtf', default='', help='Name of gtf file.', metavar='', dest='gtf')
	input_args.add_argument('-p', '--prefix', default='', help='Prefix to add to chromosome names.', metavar='', dest='prefix')
	input_args.add_argument('-q', '--postfix', default='', help='Postfix to add to chromosome names.', metavar='', dest='postfix')
	input_args.add_argument('-d', '--delimiter', default='_', help='Delimiter.', metavar='', dest='delimiter')
	return parser.parse_args()

if __name__ == "__main__":
	args = parseArguments()
	main(args)
//~@:~

